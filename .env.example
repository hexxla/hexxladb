# Example environment for local runs (`task demo` or a direct `go run`).
# Copy to `.env` and load with your shell or a tool — never commit `.env` (see `.gitignore`).
# The binary reads plain environment variables (no dotenv loader).

# slog: DEBUG, INFO, WARN, ERROR, …
LOG_LEVEL=INFO

# Optional: open this DB path on startup and run PutCell/GetCell smoke via internal/adapters/out/hexxladb.
# HEXXLA_DB_PATH=.tmp/hexxla.db
