# Example environment for local runs (`make run` / `go run ./cmd/app`).
# Copy to `.env` and load with your shell or a tool — never commit `.env` (see `.gitignore`).
# This service reads plain environment variables (no dotenv loader in the binary).

# Listen address (default :8080)
LISTEN_ADDR=:8080

# HTTP server and graceful shutdown (Go duration strings)
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# slog: DEBUG, INFO, WARN, ERROR, …
LOG_LEVEL=INFO

# Max JSON request body bytes (aligned with domain max content size by default)
HTTP_MAX_BODY_BYTES=1048576
