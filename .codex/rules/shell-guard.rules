# Shell command guardrails for Codex
# Location: .codex/rules/shell-guard.rules

# Destructive commands - require explicit approval
destructive_commands = [
    ["rm", "-rf"],
    ["rm", "-r", "-f"],
    ["sudo"],
    ["kubectl", "delete"],
]

for cmd in destructive_commands:
    prefix_rule(
        pattern = cmd,
        decision = "prompt",
        justification = "Potentially destructive operation. Confirm intent before execution.",
    )

# Network commands - prompt for safety
network_commands = [
    ["curl"],
    ["wget"],
]

for cmd in network_commands:
    prefix_rule(
        pattern = cmd,
        decision = "prompt",
        justification = "Network operation. Review URL and intent before execution.",
    )

# Docker push - production impact
docker_commands = [
    ["docker", "push"],
]

for cmd in docker_commands:
    prefix_rule(
        pattern = cmd,
        decision = "prompt",
        justification = "Publishes to container registry. Confirm image and tag before pushing.",
    )
