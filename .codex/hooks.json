{
  "hooks": {
    "FileChanged": [
      {
        "matcher": "*.go",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/format-go.sh",
            "statusMessage": "Running gofmt on edited Go file"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/scan-secrets-edited.sh",
            "statusMessage": "Scanning edited file for secrets"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/guard-shell.sh",
            "statusMessage": "Checking shell command safety"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/scan-prompt-secrets.sh",
            "statusMessage": "Scanning prompt for secrets"
          }
        ]
      }
    ]
  }
}
