{
	"version": 1,
	"hooks": {
		"afterFileEdit": [
			{
				"command": ".cursor/hooks/format-go.sh",
				"matcher": "Write|TabWrite"
			},
			{
				"command": ".cursor/hooks/scan-secrets-edited.sh",
				"matcher": "Write|TabWrite"
			}
		],
		"beforeShellExecution": [
			{
				"command": ".cursor/hooks/guard-shell.sh",
				"matcher": "curl|wget|sudo |^rm|kubectl delete|docker push"
			}
		],
		"beforeSubmitPrompt": [
			{
				"command": ".cursor/hooks/scan-prompt-secrets.sh"
			}
		]
	}
}
