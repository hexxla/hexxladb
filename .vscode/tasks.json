{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HexxlaDB: CI",
      "type": "process",
      "command": "task",
      "args": ["ci"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$go"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "HexxlaDB: Test",
      "type": "process",
      "command": "task",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$go"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "HexxlaDB: Build",
      "type": "process",
      "command": "task",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$go"]
    },
    {
      "label": "HexxlaDB: Build Examples",
      "type": "process",
      "command": "task",
      "args": ["build-examples"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$go"]
    },
    {
      "label": "HexxlaDB: Integration Tests",
      "type": "process",
      "command": "task",
      "args": ["integration"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$go"]
    },
    {
      "label": "HexxlaDB: Controlled Evidence",
      "type": "process",
      "command": "task",
      "args": ["evidence-controlled"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$go"]
    }
  ]
}
