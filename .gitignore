# Allow-list alternative (stricter): https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# --- Go build & test artifacts ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.o
*.test
*.prof
*.pprof
cpu.prof
mem.prof
coverage.*
*.coverprofile
profile.cov
coverage.html

# Fuzzing
testdata/fuzz/**/*
!testdata/fuzz/**/.gitkeep

# Delve / some IDEs
__debug_bin
__debug_bin_*

# go run output binaries (e.g. from examples/) dropped at repo root
/conversational_memory
/llm_context_engine
/tui
/bin

# --- Future / common output directories (binaries, releases, packagers) ---
bin/linux/
bin/darwin/
bin/windows/
bin/*-*/
bin/*/
/build/
/dist/
/out/
/artifacts/
/target/
/release/
/tmp/
/.tmp/
**/.tmp/
/temp/

# If you later vendor dependencies (uncomment to ignore the tree)
# vendor/

# Go workspace (local multi-module experiments)
go.work
go.work.sum

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Tooling caches (if created inside the repo) ---
.cache/

# --- Logs & OS noise ---
*.log
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.idea/
*.swp

# VS Code and Zed project settings are tracked in .vscode/ and .zed/.
# Keep assistant-specific local state out of the repository; shared Codex skills
# live under .agents/skills/.
.cursor/
.claude/
.continue/
.codex/

# Generated files
*.generated.go
*.pb.go
*.pb.gw.go
*.gen.go

# Personal notes
NOTES.md

# --- Optional: uncomment when you add these stacks ---
# node_modules/
# .terraform/
# *.tfstate*
