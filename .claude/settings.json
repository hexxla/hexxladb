{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(go *)",
      "Read(internal/**)",
      "Read(docs/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "pre_read_code": [
      {
        "command": ".claude/hooks/pre-read.sh",
        "show_output": false
      }
    ],
    "post_read_code": [
      {
        "command": ".claude/hooks/post-read-code.sh",
        "show_output": false
      }
    ],
    "pre_write_code": [
      {
        "command": ".claude/hooks/pre-write.sh",
        "show_output": false
      }
    ],
    "post_write_code": [
      {
        "command": ".claude/hooks/post-write-code.sh",
        "show_output": false
      }
    ],
    "pre_run_command": [
      {
        "command": ".claude/hooks/pre-run-command.sh",
        "show_output": false
      }
    ],
    "post_run_command": [
      {
        "command": ".claude/hooks/post-run-command.sh",
        "show_output": false
      }
    ],
    "pre_mcp_tool_use": [
      {
        "command": ".claude/hooks/pre-mcp-tool-use.sh",
        "show_output": false
      }
    ],
    "post_mcp_tool_use": [
      {
        "command": ".claude/hooks/post-mcp-tool-use.sh",
        "show_output": false
      }
    ]
  }
}
